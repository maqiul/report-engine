<Window x:Class="ReportEngine.WpfSample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewer="clr-namespace:ReportEngine.Viewer.Wpf;assembly=ReportEngine.Viewer.Wpf"
        Title="ReportEngine WPF Sample - 模板读取/替换/预览"
        Width="1100" Height="750"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧控制面板：操作按钮 + 标题替换输入框 -->
        <Border Grid.Column="0" Background="#F5F5F5" Padding="16" BorderBrush="#DDD" BorderThickness="0,0,1,0">
            <StackPanel>
                <TextBlock Text="ReportEngine WPF Sample" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock Text="演示：模板读取 + 替换 + 预览" FontSize="11" Foreground="#666" Margin="0,0,0,16" />

                <TextBlock Text="操作" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,4" />

                <Button Name="BtnLoad" Content="1. 加载模板 + 渲染预览" Height="36" Margin="0,0,0,8" Click="BtnLoad_Click" />

                <Button Name="BtnEditTitle" Content="2. 替换标题后重新渲染" Height="36" Margin="0,0,0,8" Click="BtnEditTitle_Click" />

                <Button Name="BtnSaveJson" Content="3. 保存当前模板为 JSON" Height="36" Margin="0,0,0,16" Click="BtnSaveJson_Click" />

                <TextBlock Text="状态" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,4" />
                <Border Background="#FFF" BorderBrush="#DDD" BorderThickness="1" Padding="8" MinHeight="120">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock Name="TxtStatus" TextWrapping="Wrap" FontFamily="Consolas, Courier New" FontSize="11" />
                    </ScrollViewer>
                </Border>

                <TextBlock Text="页码" FontSize="12" FontWeight="SemiBold" Margin="0,16,0,4" />
                <StackPanel Orientation="Horizontal">
                    <Button Name="BtnPrev" Content="◀ 上一页" Width="80" Margin="0,0,4,0" Click="BtnPrev_Click" />
                    <Button Name="BtnNext" Content="下一页 ▶" Width="80" Click="BtnNext_Click" />
                </StackPanel>

                <TextBlock Text="缩放" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,4" />
                <Slider Name="SliderZoom" Minimum="0.5" Maximum="2.0" Value="1.0" TickFrequency="0.25"
                        IsSnapToTickEnabled="True" ValueChanged="SliderZoom_ValueChanged" />
                <TextBlock Name="TxtZoom" Text="100%" FontSize="11" Foreground="#666" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- 右侧预览控件 -->
        <Border Grid.Column="1" Background="#888" Padding="20">
            <viewer:ReportViewerControl x:Name="Viewer" />
        </Border>
    </Grid>
</Window>